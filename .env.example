# ==============================================================================
# Ekaagra Technologies - Environment Configuration
# ==============================================================================

# Centralized Business WhatsApp Number (Optional international format, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Destination Admin Email (Where you receive lead & quote notifications)
ADMIN_EMAIL=ekaagratechnologies@gmail.com

# ------------------------------------------------------------------------------
# 1. Lead Management Database (Supabase)
# ------------------------------------------------------------------------------
# Get your project URL and keys from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
# Server-side service role key for lead persistence and RLS bypass
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional public anon key
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 1b. Schools Platform Database (Separate Supabase Project - Database B)
# ------------------------------------------------------------------------------
# Server-side connection to the Schools platform project for onboarding handoff
SCHOOLS_SUPABASE_URL=https://your-schools-project.supabase.co
SCHOOLS_SUPABASE_SERVICE_ROLE_KEY=your_schools_service_role_key_here
SCHOOLS_SUPABASE_ANON_KEY=your_schools_anon_key_here

# ------------------------------------------------------------------------------
# 2. Admin Portal Security (/admin/leads)
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_SECRET=your_random_session_secret_string_here

# ------------------------------------------------------------------------------
# 3. Email Delivery Provider (Choose Resend or SMTP)
# ------------------------------------------------------------------------------

# OPTION 1: Resend API (Recommended - https://resend.com)
RESEND_API_KEY=re_your_api_key_here
# Verified production domain sender:
FROM_EMAIL=Ekaagra Technologies <notifications@ekaagratechnologies.site>

# OPTION 2: Standard SMTP (e.g. Gmail App Password or Custom Domain SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-digit-gmail-app-password

# ------------------------------------------------------------------------------
# 4. Razorpay Payment Gateway (https://razorpay.com)
# ------------------------------------------------------------------------------
# Server-side API credentials (keep secret, never expose to client)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Client-side public key for Razorpay standard checkout popup:
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

