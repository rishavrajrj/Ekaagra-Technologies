# ==============================================================================
# Ekaagra Technologies - Environment Configuration
# ==============================================================================

# Centralized Business WhatsApp Number (Format: International without +/spaces, e.g. 917970733767)
NEXT_PUBLIC_WHATSAPP_NUMBER=917970733767

# Destination Admin Email (Where you receive lead & quote notifications)
ADMIN_EMAIL=ekaagratechnologies@gmail.com

# ------------------------------------------------------------------------------
# Email Delivery Provider (Choose Resend or SMTP)
# ------------------------------------------------------------------------------

# OPTION 1: Resend API (Recommended - https://resend.com)
RESEND_API_KEY=re_your_api_key_here
# Note: For testing before custom domain DNS verification, use: onboarding@resend.dev
# After verifying ekaagratechnologies.site domain on Resend, use: notifications@ekaagratechnologies.site
FROM_EMAIL=Ekaagra Technologies <onboarding@resend.dev>

# OPTION 2: Standard SMTP (e.g. Gmail App Password or Custom Domain SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-digit-gmail-app-password
